# ========================================================
# VernacPay AI - Environment Configuration
# ========================================================

# Port for the Node.js Commerce Gateway
PORT=3000

# Python Agent Engine URL
PYTHON_AGENT_URL=http://127.0.0.1:8000

# Google Gemini API Key (Gemini 3.8 Flash for Vernacular Voice-to-JSON Intent Routing)
# Optional: If omitted, built-in heuristic vernacular NLP engine activates automatically
GEMINI_API_KEY=

# PayPal Agentic Commerce Toolkit / Sandbox Credentials
# Optional: If omitted, autonomous agentic sandbox mode provides tokenized checkout links
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Merchant Settlement Identifier (UPI Virtual Payment Address for Dynamic QR)
MERCHANT_UPI_VPA=vernacpay.merchant@icici
MERCHANT_BUSINESS_NAME=VernacPay Street Vendor Store

# Safety Boundary: Maximum single micro-commerce transaction in INR (default 10,000)
MAX_MICRO_COMMERCE_LIMIT_INR=10000
